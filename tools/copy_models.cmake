# Copy only the model files mapped in data/models.json (plus their "extra" files and every licence/readme under
# assets/) into ${DEST}/assets, keeping relative paths. Needs CMake >= 3.19 (string(JSON)); older CMake copies all assets.
#   cmake -DSRC_DIR=<repo root> -DDEST=<dist dir> -P tools/copy_models.cmake
if(NOT SRC_DIR OR NOT DEST)
  message(FATAL_ERROR "usage: cmake -DSRC_DIR=.. -DDEST=.. -P copy_models.cmake")
endif()
file(TO_CMAKE_PATH "${SRC_DIR}" SRC_DIR)
file(TO_CMAKE_PATH "${DEST}" DEST)
file(READ "${SRC_DIR}/data/models.json" J)
string(REGEX REPLACE "(^|\n)[ \t]*//[^\n]*" "\\1" J "${J}")  # strip // comment lines (the game's JSON allows them)
set(FILES "")
if(CMAKE_VERSION VERSION_LESS 3.19)
  message(WARNING "CMake < 3.19: copying the whole assets folder")
  file(COPY "${SRC_DIR}/assets/" DESTINATION "${DEST}/assets")
  return()
endif()
string(JSON N LENGTH "${J}" models)
math(EXPR LAST "${N} - 1")
foreach(i RANGE ${LAST})
  string(JSON id MEMBER "${J}" models ${i})
  string(JSON f GET "${J}" models ${id} file)
  list(APPEND FILES "${f}")
  string(JSON ne ERROR_VARIABLE e LENGTH "${J}" models ${id} extra)
  if(NOT e AND ne GREATER 0)
    math(EXPR el "${ne} - 1")
    foreach(k RANGE ${el})
      string(JSON x GET "${J}" models ${id} extra ${k})
      list(APPEND FILES "${x}")
    endforeach()
  endif()
endforeach()
file(GLOB_RECURSE LIC RELATIVE "${SRC_DIR}" "${SRC_DIR}/assets/*License*.txt" "${SRC_DIR}/assets/*LICENSE*" "${SRC_DIR}/assets/*CREDITS*" "${SRC_DIR}/assets/*sources.json")
list(APPEND FILES ${LIC})
list(REMOVE_DUPLICATES FILES)
set(total 0)
foreach(f ${FILES})
  if(EXISTS "${SRC_DIR}/${f}")
    get_filename_component(d "${DEST}/${f}" DIRECTORY)
    file(MAKE_DIRECTORY "${d}")
    file(COPY "${SRC_DIR}/${f}" DESTINATION "${d}")
    file(SIZE "${SRC_DIR}/${f}" s)
    math(EXPR total "${total} + ${s}")
  else()
    message(WARNING "models.json lists a missing file: ${f} (the game will use the primitive fallback)")
  endif()
endforeach()
list(LENGTH FILES nf)
math(EXPR kb "${total} / 1024")
message(STATUS "Copied ${nf} model/licence files (${kb} KB) to ${DEST}/assets")
