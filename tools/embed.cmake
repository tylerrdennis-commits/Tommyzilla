# Converts data/*.json into src/generated/embedded_data.h (byte arrays) so the exe works without the data folder.
# Usage: cmake -DSRC_DIR=... -DOUT=... -P embed.cmake
set(files config moves monsters levels eggs credits)
set(out "// Generated by tools/embed.cmake - do not edit.\n#pragma once\nnamespace tz {\n")
foreach(f ${files})
  file(READ "${SRC_DIR}/data/${f}.json" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  string(APPEND out "static const unsigned char kEmbedded_${f}[] = {${arr}0x00};\n")
endforeach()
string(APPEND out "}\n")
file(WRITE "${OUT}" "${out}")
